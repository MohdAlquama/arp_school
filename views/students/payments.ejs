<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="h3 mb-1">Fee payments</h1><p class="text-muted mb-0"><%= student.student_name %><%= student.student_number ? ` · ${student.student_number}` : '' %></p></div>
    <div class="d-flex gap-2"><a href="/students/<%= student.id %>/edit" class="btn btn-outline-primary">Edit student</a><a href="/students" class="btn btn-outline-secondary">Back to students</a></div>
</div>

<% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">Total fee</div><div class="h4 mb-0">₹<%= Number(student.total_fee).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div></div></div></div>
    <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">Paid</div><div class="h4 mb-0 text-success">₹<%= paidTotal.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div></div></div></div>
    <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">Remaining</div><div class="h4 mb-0 text-warning">₹<%= remainingTotal.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div></div></div></div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-5"><form method="post" action="/students/<%= student.id %>/installments" class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h5">Add fee installment</h2><p class="text-muted small">Scheduled so far: ₹<%= plannedTotal.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %> of ₹<%= Number(student.total_fee).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>.</p><label class="form-label" for="installment-title">Part name</label><input class="form-control mb-3" id="installment-title" name="title" placeholder="Part 1" maxlength="120" required><label class="form-label" for="installment-amount">Amount (₹)</label><input class="form-control mb-3" id="installment-amount" name="amount" type="number" min="0.01" max="<%= Math.max(0, Number(student.total_fee) - plannedTotal).toFixed(2) %>" step="0.01" required><label class="form-label" for="installment-due">Due date</label><input class="form-control" id="installment-due" name="due_date" type="date"></div><div class="card-footer bg-white"><button class="btn btn-primary" <%= Number(student.total_fee) <= plannedTotal ? 'disabled' : '' %>>Add installment</button></div></form></div>
    <div class="col-lg-7"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h5">Installment schedule</h2><% if (!installments.length) { %><p class="text-muted mb-0">No installments added yet. Add parts such as ₹5,000, ₹5,000, and ₹2,000.</p><% } else { %><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Part</th><th>Due</th><th>Amount</th><th>Paid</th><th>Balance</th></tr></thead><tbody><% installments.forEach(item => { %><tr><td><strong><%= item.title %></strong><small class="d-block text-muted">Part <%= item.installment_no %></small></td><td><%= item.due_date ? new Date(item.due_date).toLocaleDateString('en-IN') : '—' %></td><td>₹<%= item.amount.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td><td>₹<%= item.paid_amount.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td><td>₹<%= item.balance.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %><% if (item.pending_amount > 0) { %><small class="d-block text-warning">₹<%= item.pending_amount.toFixed(2) %> pending online</small><% } %></td></tr><% }) %></tbody></table></div><% } %></div></div></div>
</div>

<div class="card border-0 shadow-sm mb-4"><div class="card-header bg-white"><h2 class="h5 mb-0">Collect payment</h2></div><div class="card-body"><% if (!installments.length) { %><p class="text-muted mb-0">Add an installment before recording a payment.</p><% } else { %><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Installment</th><th>Available</th><th>Payment mode and amount</th></tr></thead><tbody><% installments.forEach(item => { %><tr><td><strong><%= item.title %></strong></td><td>₹<%= item.available.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td><td><% if (item.available > 0) { %><div class="d-flex flex-wrap gap-2 align-items-start"><form method="post" action="/students/installments/<%= item.id %>/cash" class="d-flex flex-wrap gap-2"><input type="hidden" name="student_id" value="<%= student.id %>"><input class="form-control form-control-sm" name="amount" type="number" min="0.01" max="<%= item.available.toFixed(2) %>" step="0.01" value="<%= item.available.toFixed(2) %>" required style="max-width:130px"><input class="form-control form-control-sm" name="reference_number" placeholder="Cash receipt / note" maxlength="120" style="max-width:180px"><button class="btn btn-sm btn-outline-success">Record cash</button></form><form method="post" action="/students/installments/<%= item.id %>/cashfree" class="d-flex gap-2"><input type="hidden" name="student_id" value="<%= student.id %>"><input type="hidden" name="amount" value="<%= item.available.toFixed(2) %>"><button class="btn btn-sm btn-outline-primary">Cashfree QR</button></form></div><% } else { %><span class="text-muted">No amount available</span><% } %></td></tr><% }) %></tbody></table></div><% } %></div></div>

<div class="card border-0 shadow-sm"><div class="card-header bg-white"><h2 class="h5 mb-0">Payment history</h2></div><% if (!payments.length) { %><div class="card-body text-muted">No payments recorded yet.</div><% } else { %><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Part</th><th>Date</th><th>Amount</th><th>Mode</th><th>Status</th><th>Receipt / QR</th></tr></thead><tbody><% payments.forEach(payment => { %><tr><td><%= payment.title %></td><td><%= new Date(payment.created_at).toLocaleString('en-IN') %></td><td>₹<%= Number(payment.amount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td><td><%= payment.payment_mode === 'CASHFREE' ? 'Cashfree' : 'Cash' %></td><td><span class="badge <%= payment.status === 'PAID' ? 'bg-success' : payment.status === 'PENDING' ? 'bg-warning text-dark' : 'bg-secondary' %>"><%= payment.status %></span></td><td><% if (payment.cashfree_link_url) { %><a href="<%= payment.cashfree_link_url %>" target="_blank" rel="noopener">Open payment link</a><% if (payment.status === 'PENDING') { %><div class="cashfree-qr mt-2" data-url="<%= payment.cashfree_link_url %>" data-payment-id="<%= payment.id %>"></div><% } %><% } else { %><%= payment.reference_number || '—' %><% } %></td></tr><% }) %></tbody></table></div><% } %></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
document.querySelectorAll('.cashfree-qr').forEach(element => {
    if (window.QRCode && element.dataset.url) new QRCode(element, { text: element.dataset.url, width: 140, height: 140, correctLevel: QRCode.CorrectLevel.M });
});
</script>
