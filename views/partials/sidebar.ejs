<aside class="sidebar" id="sidebar">

    <div class="sidebar-brand">
        <div class="brand-logo">
            <i class="fas fa-cube"></i>
        </div>

        <div class="brand-name">
            Admin<span>Panel</span>
        </div>

        <button class="sidebar-close d-lg-none" id="sidebarClose">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <div class="sidebar-body">

        <div class="menu-label">MAIN MENU</div>

        <% if (canSee('dashboard')) { %><a href="/dashboard"
           class="sidebar-link <%= page === 'dashboard' ? 'active' : '' %>">
            <i class="fas fa-chart-pie"></i>
            <span>Dashboard</span>
        </a><% } %>

        <div class="menu-label">MANAGEMENT</div>

        <% if (canSee('products')) { %><a href="/products" class="sidebar-link">
            <i class="fas fa-box"></i>
            <span>Products</span>
            <i class="fas fa-chevron-down ms-auto menu-arrow"></i>
        </a><% } %>

        <% if (canSee('students')) { %><a href="/students" class="sidebar-link <%= page === 'students' ? 'active' : '' %>">
            <i class="fas fa-user-graduate"></i>
            <span>Students</span>
        </a><% } %>

        <% if (canSee('orders')) { %><a href="/orders" class="sidebar-link">
            <i class="fas fa-shopping-cart"></i>
            <span>Orders</span>
            <span class="menu-badge">12</span>
        </a><% } %>

        <% if (canSee('customers')) { %><a href="/customers" class="sidebar-link">
            <i class="fas fa-users"></i>
            <span>Customers</span>
        </a><% } %>

        <% if (canSee('inventory')) { %><a href="/inventory" class="sidebar-link">
            <i class="fas fa-warehouse"></i>
            <span>Inventory</span>
        </a><% } %>

        <% if (canSee('categories')) { %><a href="/categories" class="sidebar-link <%= page === 'categories' ? 'active' : '' %>">
            <i class="fas fa-tags"></i>
            <span>Categories</span>
        </a><% } %>

        <div class="menu-label">FINANCE & REPORTS</div>

        <% if (canSee('invoices')) { %><a href="/invoices" class="sidebar-link">
            <i class="fas fa-file-invoice"></i>
            <span>Invoices</span>
        </a><% } %>

        <% if (canSee('reports')) { %><a href="/reports" class="sidebar-link">
            <i class="fas fa-chart-line"></i>
            <span>Reports</span>
        </a><% } %>

        <% if (canSee('payments')) { %><a href="/cashfree" class="sidebar-link <%= page === 'cashfree' ? 'active' : '' %>">
            <i class="fas fa-wallet"></i>
            <span>Cashfree</span>
        </a><% } %>

        <div class="menu-label">SYSTEM</div>

        <% if (canSee('settings')) { %><a href="/settings" class="sidebar-link">
            <i class="fas fa-cog"></i>
            <span>Settings</span>
        </a><% } %>

        <% if (canSee('users')) { %><a href="/users" class="sidebar-link">
            <i class="fas fa-user-shield"></i><span>Users & Permissions</span>
        </a><% } %>

        <% if (canSee('profile')) { %><a href="#" class="sidebar-link">
            <i class="fas fa-user-circle"></i>
            <span>My Profile</span>
        </a><% } %>

    </div>

    <div class="sidebar-footer">
        <div class="sidebar-version">
            <div class="version-icon">
                <i class="fas fa-code-branch"></i>
            </div>

            <div>
                <strong>Admin Panel</strong>
                <small>Version 1.0.0</small>
            </div>
        </div>
    </div>

</aside>

<div class="sidebar-overlay" id="sidebarOverlay"></div>
